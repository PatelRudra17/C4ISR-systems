# Application Settings
DEBUG=False
ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost:3000,https://aegis.mil.local

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aegis_c4isr
POSTGRES_USER=aegis_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# InfluxDB Time-Series Database
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=CHANGE_ME_INFLUX_TOKEN_64_CHARS_MINIMUM
INFLUX_ORG=aegis_command
INFLUX_BUCKET_GPS=gps_telemetry
INFLUX_BUCKET_SENSOR=sensor_data
INFLUX_BUCKET_THREAT=threat_events
INFLUX_BUCKET_CYBER=cyber_events
INFLUX_PASSWORD=CHANGE_ME_INFLUX_PASSWORD

# Redis Cache & PubSub
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_TTL_GPS=30
REDIS_TTL_THREAT=300
REDIS_TTL_DRONE=10

# JWT Authentication (Generate: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32_TO_GENERATE
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# AES Encryption (MUST be exactly 32 characters)
AES_KEY=CHANGE_ME_EXACTLY_32_CHARS_KEY!

# Multi-Factor Authentication
MFA_REQUIRED=True
MFA_ISSUER=AEGIS_C4ISR

# MAVLink Drone Connection
MAVLINK_HOST=0.0.0.0
MAVLINK_PORT=14550
DRONE_TELEMETRY_RATE=10
MAX_DRONES=32
GEOFENCE_DEFAULT_RADIUS=5000

# AI Threat Detection
YOLO_MODEL_PATH=/app/models/yolov8n.pt
AI_CONFIDENCE_THRESHOLD=0.65
AI_DEVICE=cpu
TF_ENABLE_ONEDNN_OPTS=0

# Kafka Event Streaming
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC_GPS=gps.telemetry
KAFKA_TOPIC_THREATS=threat.detected
KAFKA_TOPIC_AUDIT=audit.log
KAFKA_TOPIC_CYBER=cyber.events

# Rate Limiting
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/aegis/app.log
